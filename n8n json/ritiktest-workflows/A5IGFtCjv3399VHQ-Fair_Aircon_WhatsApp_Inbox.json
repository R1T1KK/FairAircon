          "cachedResultName": "Fair Aircon WhatsApp Receptionist"
        },
        "message": "=[Customer WhatsApp number: {{ $json.wa_from }} | WhatsApp name: {{ $json.wa_name || \"unknown\" }} | Now (IST): {{ $now.setZone(\"Asia/Kolkata\").toFormat(\"cccc yyyy-MM-dd HH:mm\") }}]\n{{ $json.msg_text }}",
        "advanced": {
          "enableStreaming": false,
          "invokeMode": "perItem",
          "session": {
            "session": {
              "sessionIdType": "customKey",
              "sessionKey": "={{ \"wa-\" + $json.wa_from }}"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
