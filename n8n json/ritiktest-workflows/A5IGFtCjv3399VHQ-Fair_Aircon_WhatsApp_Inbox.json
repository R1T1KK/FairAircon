      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        272,
        224
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ ($json.messages || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      }
    },
    {
      "id": "755bc7c2-6772-4315-976f-760babe0ae21",
      "name": "Normalize Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        496,
        224
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "msg_id",
              "value": "={{ $json.messages[0].id }}",
              "type": "string"
            },
            {
              "id": "n2",
              "name": "wa_from",
              "value": "={{ $json.messages[0].from }}",
              "type": "string"
            },
            {
              "id": "n3",
              "name": "wa_name",
              "value": "={{ ($json.contacts && $json.contacts[0] && $json.contacts[0].profile && $json.contacts[0].profile.name) || \"\" }}",
              "type": "string"
            },
            {
              "id": "n4",
              "name": "msg_type",
              "value": "={{ $json.messages[0].type }}",
              "type": "string"
            },
            {
              "id": "n5",
              "name": "msg_text",
              "value": "={{ (($json.messages[0].text && $json.messages[0].text.body) || ($json.messages[0].interactive && (($json.messages[0].interactive.button_reply && $json.messages[0].interactive.button_reply.title) || ($json.messages[0].interactive.list_reply && $json.messages[0].interactive.list_reply.title))) || ($json.messages[0].button && $json.messages[0].button.text) || \"\").trim().slice(0, 2000) }}",
              "type": "string"
            },
            {
              "id": "n6",
              "name": "phone_number_id",
              "value": "={{ $json.metadata.phone_number_id }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "5a64dd3a-b023-45b6-b32c-23c88ffbee65",
      "name": "Skip Already Handled Messages",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        720,
        224
      ],
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.msg_id }}",
        "options": {
          "historySize": 10000
        }
      }
    },
    {
      "id": "9552c95f-518c-46e5-9056-84e046ae0934",
      "name": "Has Text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        944,
        224
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.msg_text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
