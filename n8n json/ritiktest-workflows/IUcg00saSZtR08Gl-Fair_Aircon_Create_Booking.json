    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const TZ = 'Asia/Kolkata';\nconst SERVICES = [\n  ['general servicing', 'AC General Servicing', 60], ['deep clean', 'AC Deep Cleaning', 90],\n  ['repair', 'AC Repair and Troubleshooting', 120], ['troubleshoot', 'AC Repair and Troubleshooting', 120],\n  ['gas', 'AC Gas Refilling', 60], ['uninstall', 'AC Uninstallation', 120],\n  ['install', 'AC Installation', 180], ['maintenance', 'AC Maintenance', 60],\n  ['cleaning', 'AC Deep Cleaning', 90], ['servic', 'AC General Servicing', 60],\n];\nconst r = $json;\nconst errors = [];\nconst clean = v => String(v == null ? '' : v).trim();\nconst name = clean(r.customer_name || r.name);\nconst address = clean(r.address);\nconst city = clean(r.city);\nconst notes = clean(r.notes).slice(0, 500);\nconst source = clean(r.source).toLowerCase() || 'whatsapp';\nlet phone = clean(r.phone).replace(/[^0-9]/g, '');\nif (phone.length === 10) phone = '91' + phone;\nif (phone.length === 11 && phone.startsWith('0')) phone = '91' + phone.slice(1);\nif (!/^\\d{11,15}$/.test(phone)) errors.push('phone must be a valid mobile number with country code');\nif (name.length < 2) errors.push('customer_name is required');\nif (address.length < 8) errors.push('full service address is required');\n\nconst svcIn = clean(r.service).toLowerCase();\nlet service = '', duration = 0\nfor (const s of SERVICES) { if (svcIn.includes(s[0])) { service = s[1]; duration = s[2]; break; } }\nif (!service) errors.push('service must be one of: General Servicing, Deep Cleaning, Repair, Gas Refilling, Installation, Uninstallation, Maintenance');\n\nconst dateStr = clean(r.date);\nconst timeStr = clean(r.start_time || r.preferred_time);\nlet start = null, end = null;\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(dateStr)) errors.push('date must be YYYY-MM-DD');\nif (!/^\\d{1,2}:\\d{2}$/.test(timeStr)) errors.push('start_time must be HH:mm (24h)');\nif (!errors.some(e => e.startsWith('date') || e.startsWith('start_time'))) {\n  const [hh, mm] = timeStr.split(':').map(Number);\n  start = DateTime.fromISO(dateStr, { zone: TZ }).set({ hour: hh, minute: mm, second: 0, millisecond: 0 });\n  if (!start.isValid) errors.push('invalid date/time');\n  else {\n    end = start.plus({ minutes: duration || 60 });\n    const open = start.set({ hour: 9, minute: 0 });\n    const close = start.set({ hour: 19, minute: 0 });\n    if (start.weekday === 7) errors.push('we are closed on Sundays');\n    if (start < open || end > close) errors.push('booking must fit within working hours 09:00-19:00');\n    if (start < DateTime.now().setZone(TZ).plus({ hours: 1 })) errors.push('booking time must be at least 1 hour from now');\n  }\n}\nconst bookingId = (start && phone)\n  ? 'FA-' + start.toFormat('yyMMdd-HHmm') + '-' + phone.slice(-4)\n  : '';\nreturn { json: {\n  valid: errors.length === 0,\n  errors,\n  booking_id: bookingId,\n  customer_name: name,\n  phone,\n  service,\n  duration_min: duration,\n  date: dateStr,\n  start_time: start ? start.toFormat('HH:mm') : timeStr,\n  end_time: end ? end.toFormat('HH:mm') : '',\n  start_iso: start ? start.toISO() : '',\n  end_iso: end ? end.toISO() : '',\n  address,\n  city,\n  notes,\n  source,\n  display_when: start ? start.toFormat(\"cccc, d LLL yyyy 'at' h:mm a\") : '',\n} };"
      },
