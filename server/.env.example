# ============================================================
# Fair Aircon Server Environment Configuration
# Copy this file to .env and provide your secrets
# ============================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fairaircon?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_secure_random_string
JWT_EXPIRE=7d

# Email Transporter (Gmail App Password)
EMAIL_USER=Fairaircon777@gmail.com
EMAIL_PASS=your_16_digit_app_password
OWNER_EMAIL=Fairaircon777@gmail.com

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Settings
ADMIN_URL=http://localhost:5173/admin
ADMIN_PHONE=+919876543210

# n8n Integration API Secret (generate a secure random string)
N8N_BOOKING_API_SECRET=your_n8n_api_secret_here

# ------------------------------------------------------------
# SMS Provider Options (Twilio / Fast2SMS / MSG91)
# Note: In development mode, if left unset, OTPs are safely
# displayed in server console for rapid testing.
# ------------------------------------------------------------

# Option A: Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option B: Fast2SMS (Indian SMS Gateway)
FAST2SMS_API_KEY=

# Option C: MSG91 (Indian SMS Gateway)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development flags
DISABLE_RATE_LIMIT=false

